    .global _start
_start:
    CALL main
    HALT
    .global main
main:
    PUSH R6
    PUSH R1
    PUSH R2
    PUSH R3
    MOV R6, SP
    LDI R4, 2
    SUB SP, SP, R4
    LDI R0, 0
    LDI R4, -1
    ADD R4, R6, R4
    STR [R4], R0
    LDI R0, 0
    LDI R4, -2
    ADD R4, R6, R4
    STR [R4], R0
.loop_0:
    LDI R4, -2
    ADD R4, R6, R4
    LDR R0, [R4]
    LDI R1, 3
    CMP R0, R1
    JL .cmp_true_3
    LDI R0, 0
    JMP .cmp_end_4
.cmp_true_3:
    LDI R0, 1
.cmp_end_4:
    LDI R4, 0
    CMP R0, R4
    JE .endfor_2
    LDI R4, -1
    ADD R4, R6, R4
    LDR R0, [R4]
    LDI R4, -2
    ADD R4, R6, R4
    LDR R1, [R4]
    ADD R0, R0, R1
    LDI R4, -1
    ADD R4, R6, R4
    STR [R4], R0
.forcont_1:
    LDI R4, -2
    ADD R4, R6, R4
    LDR R0, [R4]
    LDI R1, 1
    ADD R0, R0, R1
    LDI R4, -2
    ADD R4, R6, R4
    STR [R4], R0
    JMP .loop_0
.endfor_2:
    LDI R4, -1
    ADD R4, R6, R4
    LDR R0, [R4]
    JMP .main_ret
.main_ret:
    MOV SP, R6
    POP R3
    POP R2
    POP R1
    POP R6
    RET
    .syscall putchar, 14, 1
    .syscall putint, 15, 1
    .syscall getchar, 16, 0
    .syscall getint, 17, 0
    .syscall alloc, 12, 1
    .syscall free, 13, 1
    .syscall exit, 18, 1
    .syscall putstr, 19, 2
    .syscall sleep, 20, 1
