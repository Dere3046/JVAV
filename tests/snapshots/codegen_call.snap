    .global _start
_start:
    CALL main
    HALT
    .global add
add:
    PUSH R6
    PUSH R1
    PUSH R2
    PUSH R3
    MOV R6, SP
    LDI R4, 5
    ADD R4, R6, R4
    STR [R4], R0
    LDI R4, 6
    ADD R4, R6, R4
    STR [R4], R1
    LDI R4, 5
    ADD R4, R6, R4
    LDR R0, [R4]
    LDI R4, 6
    ADD R4, R6, R4
    LDR R1, [R4]
    ADD R0, R0, R1
    JMP .add_ret
.add_ret:
    MOV SP, R6
    POP R3
    POP R2
    POP R1
    POP R6
    RET
    .global main
main:
    PUSH R6
    PUSH R1
    PUSH R2
    PUSH R3
    MOV R6, SP
    LDI R0, 3
    PUSH R0
    LDI R0, 5
    PUSH R0
    LDI R4, 1
    ADD R4, SP, R4
    LDR R0, [R4]
    LDI R4, 0
    ADD R4, SP, R4
    LDR R1, [R4]
    CALL add
    LDI R4, 2
    ADD SP, SP, R4
    JMP .main_ret
.main_ret:
    MOV SP, R6
    POP R3
    POP R2
    POP R1
    POP R6
    RET
    .syscall putchar, 14, 1
    .syscall putint, 15, 1
    .syscall getchar, 16, 0
    .syscall getint, 17, 0
    .syscall alloc, 12, 1
    .syscall free, 13, 1
    .syscall exit, 18, 1
    .syscall putstr, 19, 2
    .syscall sleep, 20, 1
