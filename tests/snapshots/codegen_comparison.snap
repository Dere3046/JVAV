    .global _start
_start:
    CALL main
    HALT
    .global main
main:
    PUSH R6
    PUSH R1
    PUSH R2
    PUSH R3
    MOV R6, SP
    LDI R4, 6
    SUB SP, SP, R4
    LDI R0, 1
    LDI R1, 2
    CMP R0, R1
    JE .cmp_true_0
    LDI R0, 0
    JMP .cmp_end_1
.cmp_true_0:
    LDI R0, 1
.cmp_end_1:
    LDI R4, -1
    ADD R4, R6, R4
    STR [R4], R0
    LDI R0, 3
    LDI R1, 4
    CMP R0, R1
    JNE .cmp_true_2
    LDI R0, 0
    JMP .cmp_end_3
.cmp_true_2:
    LDI R0, 1
.cmp_end_3:
    LDI R4, -2
    ADD R4, R6, R4
    STR [R4], R0
    LDI R0, 5
    LDI R1, 6
    CMP R0, R1
    JL .cmp_true_4
    LDI R0, 0
    JMP .cmp_end_5
.cmp_true_4:
    LDI R0, 1
.cmp_end_5:
    LDI R4, -3
    ADD R4, R6, R4
    STR [R4], R0
    LDI R0, 7
    LDI R1, 8
    CMP R0, R1
    JG .cmp_true_6
    LDI R0, 0
    JMP .cmp_end_7
.cmp_true_6:
    LDI R0, 1
.cmp_end_7:
    LDI R4, -4
    ADD R4, R6, R4
    STR [R4], R0
    LDI R0, 9
    LDI R1, 10
    CMP R0, R1
    JE .cmp_true_8
    JL .cmp_true_8
    LDI R0, 0
    JMP .cmp_end_9
.cmp_true_8:
    LDI R0, 1
.cmp_end_9:
    LDI R4, -5
    ADD R4, R6, R4
    STR [R4], R0
    LDI R0, 11
    LDI R1, 12
    CMP R0, R1
    JE .cmp_true_10
    JG .cmp_true_10
    LDI R0, 0
    JMP .cmp_end_11
.cmp_true_10:
    LDI R0, 1
.cmp_end_11:
    LDI R4, -6
    ADD R4, R6, R4
    STR [R4], R0
    LDI R0, 0
    JMP .main_ret
.main_ret:
    MOV SP, R6
    POP R3
    POP R2
    POP R1
    POP R6
    RET
    .syscall putchar, 14, 1
    .syscall putint, 15, 1
    .syscall getchar, 16, 0
    .syscall getint, 17, 0
    .syscall alloc, 12, 1
    .syscall free, 13, 1
    .syscall exit, 18, 1
    .syscall putstr, 19, 2
    .syscall sleep, 20, 1
