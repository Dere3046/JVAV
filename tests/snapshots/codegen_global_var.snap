    .global _start
_start:
    CALL main
    HALT
    .data
g:
    DT 42
    .text
    .global main
main:
    PUSH R6
    PUSH R1
    PUSH R2
    PUSH R3
    MOV R6, SP
    LDR R0, [g]
    JMP .main_ret
.main_ret:
    MOV SP, R6
    POP R3
    POP R2
    POP R1
    POP R6
    RET
    .syscall putchar, 14, 1
    .syscall putint, 15, 1
    .syscall getchar, 16, 0
    .syscall getint, 17, 0
    .syscall alloc, 12, 1
    .syscall free, 13, 1
    .syscall exit, 18, 1
    .syscall putstr, 19, 2
    .syscall sleep, 20, 1
