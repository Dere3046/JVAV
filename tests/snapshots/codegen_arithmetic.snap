    .global _start
_start:
    CALL main
    HALT
    .global main
main:
    PUSH R6
    PUSH R1
    PUSH R2
    PUSH R3
    MOV R6, SP
    LDI R4, 1
    SUB SP, SP, R4
    LDI R0, 1
    LDI R1, 2
    ADD R0, R0, R1
    LDI R1, 3
    LDI R2, 4
    MUL R1, R1, R2
    LDI R2, 5
    DIV R1, R1, R2
    LDI R2, 6
    MOD R1, R1, R2
    SUB R0, R0, R1
    LDI R4, -1
    ADD R4, R6, R4
    STR [R4], R0
    LDI R4, -1
    ADD R4, R6, R4
    LDR R0, [R4]
    JMP .main_ret
.main_ret:
    MOV SP, R6
    POP R3
    POP R2
    POP R1
    POP R6
    RET
    .syscall putchar, 14, 1
    .syscall putint, 15, 1
    .syscall getchar, 16, 0
    .syscall getint, 17, 0
    .syscall alloc, 12, 1
    .syscall free, 13, 1
    .syscall exit, 18, 1
    .syscall putstr, 19, 2
    .syscall sleep, 20, 1
