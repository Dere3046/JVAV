func side_effect(x: int): int {
    putint(9);
    return x;
}

func main(): int {
    // short-circuit: side_effect should NOT be called
    var r1 = 0 && side_effect(1);
    // short-circuit: side_effect SHOULD be called
    var r2 = 1 || side_effect(1);
    putint(r1);
    putint(r2);
    return 0;
}
