func main(): int {
    var x = 2;
    switch (x) {
        case 1: {
            putint(10);
        }
        case 2: {
            putint(20);
            break;
        }
        case 3: {
            putint(30);
        }
        default: {
            putint(99);
        }
    }
    putint(0);
    return 0;
}
