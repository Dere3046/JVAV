struct Buffer {
    data: int[4];
    len: int;
};

func main(): int {
    var b: ptr<struct Buffer> = alloc(sizeof(struct Buffer));
    b->data[0] = 1;
    b->data[1] = 2;
    b->data[2] = 3;
    b->data[3] = 4;
    b->len = 4;
    putint(b->data[0] + b->data[3]);
    putint(b->len);
    return 0;
}
