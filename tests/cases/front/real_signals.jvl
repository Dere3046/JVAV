struct proc {
    pid: int;
    state: int;
    pending_signals: uint;
};

#define MAX_PROC 4
#define SIG_KILL 1

func main(): int {
    var table: ptr<struct proc> = alloc(MAX_PROC * sizeof(struct proc));
    table->pending_signals = 0;
    table->pending_signals = table->pending_signals | (1 << SIG_KILL);
    putint((table->pending_signals >> SIG_KILL) & 1);
    table->pending_signals = table->pending_signals & ~(1 << SIG_KILL);
    putint((table->pending_signals >> SIG_KILL) & 1);
    return 0;
}
