struct vfs_dirent_t {
    ino: int;
    name: int[16];
};

struct vfs_inode_t {
    type: int;
    size: int;
    blocks: int[8];
    ref_count: int;
    parent_ino: int;
};

#define VFS_BLOCK_SIZE 16

func main(): int {
    var sz = sizeof(struct vfs_inode_t);
    putint(sz);
    var off = offsetof(struct vfs_inode_t, ref_count);
    putint(off);
    var ents_per_block = VFS_BLOCK_SIZE / sizeof(struct vfs_dirent_t);
    putint(ents_per_block);
    return 0;
}
