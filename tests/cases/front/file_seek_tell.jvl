import "std/file.jvl";

func main(): int {
    var fd = fopen("test_seek.txt", "wb");
    var buf: ptr<int> = alloc(4);
    buf[0] = 65; buf[1] = 66; buf[2] = 67; buf[3] = 68;
    fwrite(fd, buf, 4);
    fclose(fd);

    fd = fopen("test_seek.txt", "rb");
    fseek(fd, 2, 0);
    var pos = ftell(fd);
    putint(pos);

    var rbuf: ptr<int> = alloc(1);
    var n = fread(fd, rbuf, 1);
    putint(n);
    putint(rbuf[0]);
    fclose(fd);
    return 0;
}
